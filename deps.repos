# Source dependencies pinned to exact commits.
# Import from the repository root with:
#
#   vcs import --recursive . < deps.repos
#
# (sudo apt install python3-vcstool  — or pip install vcstool)
#
# These used to be committed as flattened copies; they are byte-identical
# to the upstream commits pinned below (verified 2026-07-02). Project-local
# parameter tuning that previously lived inside the ardupilot tree was moved
# to src/hydrone_bringup/config/params/.
repositories:
  src/ardupilot:
    type: git
    url: https://github.com/ArduPilot/ardupilot.git
    version: 95d083f5cf5c89801fcdb399105f0039880f2e25
  src/micro_ros_agent:
    type: git
    url: https://github.com/micro-ROS/micro-ROS-Agent.git
    version: 4f363a79ae96aed39dcc5269f53f73f6a70d3a2c
  src/micro_ros_msgs:
    type: git
    url: https://github.com/micro-ROS/micro_ros_msgs.git
    version: 2ea89dcb89a524b09fbde7d11f8bd9cddb0598d8
  # MAVROS. Built from source because the humble BINARIES ARE GONE: as of the
  # 2026-09-07 sync, packages.ros.org carries only ros-humble-mavlink and
  # ros-humble-mavros-msgs for humble — ros-humble-mavros, -mavros-extras and
  # -libmavconn were all dropped (the iron builds of the same packages are
  # still there, so this is a humble-specific removal, not an upstream
  # retirement). Pinned to 2.15.1, the exact version the mavros_msgs binary
  # still advertises, so nothing here moves relative to what used to be
  # installed.
  src/mavros:
    type: git
    url: https://github.com/mavlink/mavros.git
    version: 0755770a058e2aed558b3d4fc10e45ba68d2b117
  # NOTE: ArduPilot's fork, not eProsima upstream — the pinned commit only
  # exists there (it carries ArduPilot patches, e.g. the OMG-IDL-Parser
  # submodule and C++ const generation).
  tools/Micro-XRCE-DDS-Gen:
    type: git
    url: https://github.com/ArduPilot/Micro-XRCE-DDS-Gen.git
    version: b8840058b81c87e1169a5a0ed4744d7b3dc99e0b
