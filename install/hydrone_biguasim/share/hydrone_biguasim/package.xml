<?xml version="1.0"?>
<package format="3">
  <name>hydrone_biguasim</name>
  <version>1.0.0</version>
  <description>BiguaSim integration bridge for the Hydrone competition stack</description>
  <maintainer email="team@hydrone.com">Hydrone Team</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>tf2_ros</depend>

  <!-- BiguaSim packages -->
  <exec_depend>biguasim_main</exec_depend>
  <exec_depend>biguasim_interfaces</exec_depend>

  <!-- Hydrone stack -->
  <exec_depend>hydrone_bringup</exec_depend>
  <exec_depend>hydrone_msgs</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
