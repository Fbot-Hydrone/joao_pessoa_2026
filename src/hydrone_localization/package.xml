<?xml version="1.0"?>
<package format="3">
  <name>hydrone_localization</name>
  <version>1.0.0</version>
  <description>Where the drone thinks it is: visual odometry, the map->odom edge, and the pose fed to ArduPilot</description>
  <maintainer email="team@hydrone.com">Hydrone Team</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>tf2_ros</depend>
  <depend>mavros_msgs</depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
