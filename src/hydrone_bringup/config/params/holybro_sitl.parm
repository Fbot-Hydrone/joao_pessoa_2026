FRAME_TYPE	1
DDS_DOMAIN_ID   42
# Companion/autonomous control: disable the RC flight-mode channel so a
# GCS/companion GUIDED command sticks. SITL's default RC5 (~1800us) otherwise
# maps to FLTMODE6=STABILIZE and keeps reverting the mode, blocking NAV_TAKEOFF.
FLTMODE_CH      0
# --- GPS-denied flight on ZED visual odometry (external nav) ---
# CBR rules ban GPS in the arena, so EKF3 takes horizontal position/velocity and
# yaw from external nav: VISION_POSITION_ESTIMATE fed via MAVROS from the ZED
# odometry (/zed/zed_node/odom). Altitude stays on baro (VO Z is unreliable).
# VISO_TYPE=1 enables the MAVLink visual-odometry backend. See develop-pipelines.
GPS1_TYPE       0
VISO_TYPE       1
EK3_SRC1_POSXY  6
EK3_SRC1_VELXY  6
EK3_SRC1_POSZ   1
EK3_SRC1_VELZ   0
# Yaw from the compass, not vision: the ZED odom quaternion is ENU and feeding
# it as vision yaw risks a frame mismatch (huge yaw innovation -> unhealthy EKF
# -> position not OK -> GUIDED takeoff refused). Compass is reliable; vision
# supplies position only. Revisit once real VO yaw is validated in NED.
EK3_SRC1_YAW    1
# --- Down-facing rangefinder (Phase 1&2 sensor config) ---
# MAVLink rangefinder fed by rangefinder_bridge -> MAVROS distance_sensor ->
# DISTANCE_SENSOR. Used as a Z REFERENCE for landing/flare only, deliberately
# NOT a global EKF height source: EK3_SRC*_POSZ stays on baro (=1) and
# EK3_RNG_USE_HGT is left disabled (-1). Baro remains the complementary Z.
RNGFND1_TYPE    10
RNGFND1_ORIENT  25
RNGFND1_MIN_CM  20
RNGFND1_MAX_CM  4000
EK3_RNG_USE_HGT -1
# Keep in step with the BiguaSim JSON FDM rate (config.yaml ticks_per_sec): the
# scheduler must not expect updates faster than the bridge loop delivers, and
# arming needs gyro (= ticks_per_sec) >= 1.8 * SCHED_LOOP_RATE. Cameras off, the
# loop sustains ~260 Hz so ticks_per_sec=200 and a 100 Hz attitude loop are
# stable (a 50 Hz loop lags and oscillates). Lower both if cameras are re-enabled.
SCHED_LOOP_RATE 100
FS_THR_ENABLE   1
ARSPD_PIN 1
ARSPD_BUS 2
# BISECT STEP 1 (2026-08-19): the "fly slow" tuning block that lived here was
# REMOVED, so roll/pitch angle+rate gains, ATC_INPUT_TC, PSC_ANGLE_MAX and the
# WPNAV_* limits are back at firmware defaults. It stacked four softenings on one
# loop (angle P 4.5->1.5, INPUT_TC 0.15->0.4, rate P/I/D -41%, lean cap 30->10 deg),
# which made the attitude loop too slow for the position controller to track and
# capped the authority to recover. The block is kept verbatim, with the re-apply
# order, in docs/PARAMS-DIFF-SITL.md - it was never committed, so that is the only copy.
ATC_RAT_YAW_P 0.3
ATC_RAT_YAW_I 0.02
BATT_MONITOR    4
COMPASS_OFS_X   5
COMPASS_OFS_Y   13
COMPASS_OFS_Z   -18
COMPASS_OFS2_X   5
COMPASS_OFS2_Y   13
COMPASS_OFS2_Z   -18
COMPASS_OFS3_X   5
COMPASS_OFS3_Y   13
COMPASS_OFS3_Z   -18
FENCE_RADIUS    150
FRAME_CLASS     1
RC1_MAX         2000.000000
RC1_MIN         1000.000000
RC1_TRIM        1500.000000
RC2_MAX         2000.000000
RC2_MIN         1000.000000
RC2_TRIM        1500.000000
RC3_MAX         2000.000000
RC3_MIN         1000.000000
RC3_TRIM        1500.000000
RC4_MAX         2000.000000
RC4_MIN         1000.000000
RC4_TRIM        1500.000000
RC5_MAX         2000.000000
RC5_MIN         1000.000000
RC5_TRIM        1500.000000
RC6_MAX         2000.000000
RC6_MIN         1000.000000
RC6_TRIM        1500.000000
RC7_MAX         2000.000000
RC7_MIN         1000.000000
RC7_OPTION      7
RC7_TRIM        1500.000000
RC8_MAX         2000.000000
RC8_MIN         1000.000000
RC8_TRIM        1500.000000
FLTMODE1        7
FLTMODE2        9
FLTMODE3        6
FLTMODE4        3
FLTMODE5        5
FLTMODE6		0
SIM_BARO_RND    0
# "Arm: Accels inconsistent" blocks arming for minutes. NOT a real disagreement
# and NOT a noise problem — zeroing SIM_*_RND (below) measurably did nothing.
# It is a fixed hold-down timer. AP_Arming::ins_accels_consistent() requires the
# check to pass continuously for AP_ARMING_IMU_CONSISTENCY_CHECK_TIME_MS (10000)
# before arming is allowed, and it gates that wait on the number of REGISTERED
# accels:
#     if (ins.get_accel_count() > 1 && now - last_accel_pass_ms < 10000)
#         return false;                          // AP_Arming.cpp:479
# Under --synthetic-clock those 10s are SIM time, and with our camera render
# load sim time runs far below real time — hence "minutes".
#
# INS_USE2/INS_USE3 do NOT fix this. They only make accels_consistent() skip
# those instances in its comparison loop (AP_InertialSensor.cpp:1562); they do
# not change get_accel_count(), so the 10s gate still applies. The fix is to
# register only ONE IMU: SITL creates SIM_IMU_COUNT backends (default 2, see
# SITL.cpp:533) at AP_InertialSensor.cpp:1215. With one, accels_consistent()
# short-circuits at accel_count <= 1 AND the timing gate is skipped entirely,
# so arming is allowed immediately. Same gate exists for gyros (AP_Arming.cpp
# :506), so this covers "Gyros inconsistent" too.
#
# Read once at backend detection => changing it needs a sim RESTART, and since
# we launch with --wipe a live `param set` will not survive.
#
# SIM_IMU_COUNT is a SITL-only parameter and this is a SIM-ONLY file: the real
# Pixhawk keeps all its IMUs and its consistency check untouched. Trade-off is
# that IMU failover / affinity bugs cannot be reproduced in sim.
SIM_IMU_COUNT   1
SIM_ACC1_RND    0
SIM_ACC2_RND    0
SIM_GYR1_RND    0
SIM_GYR2_RND    0
# redundant now that only one IMU is registered; kept to document the intent
INS_USE2        0
INS_USE3        0
EK3_IMU_MASK    1
# accel_calibrated_ok_all() has TWO halves, and SIM_IMU_COUNT decides which
# half each instance falls into. Instances [0, get_accel_count()) must have
# NON-ZERO offsets and scale, or you get "3D Accel calibration needed".
# Instances [get_accel_count(), INS_MAX_INSTANCES) must have ZERO offsets and
# scale of exactly 0 or 1, or you get the SAME message ("no unused accels
# should have offsets or scaling", AP_InertialSensor.cpp).
#
# So with SIM_IMU_COUNT 1 only instance 0 carries the small fake calibration;
# INS_ACC2_* and INS_ACC3_* must both look untouched. If you ever raise
# SIM_IMU_COUNT back to 2, INS_ACC2OFFS/SCAL must go back to 0.001/1.001 or
# arming breaks the other way.
INS_ACCOFFS_X   0.001
INS_ACCOFFS_Y   0.001
INS_ACCOFFS_Z   0.001
INS_ACCSCAL_X   1.001
INS_ACCSCAL_Y   1.001
INS_ACCSCAL_Z   1.001
INS_ACC2OFFS_X   0.000
INS_ACC2OFFS_Y   0.000
INS_ACC2OFFS_Z   0.000
INS_ACC2SCAL_X   1.000
INS_ACC2SCAL_Y   1.000
INS_ACC2SCAL_Z   1.000
INS_ACC3OFFS_X   0.000
INS_ACC3OFFS_Y   0.000
INS_ACC3OFFS_Z   0.000
INS_ACC3SCAL_X   1.000
INS_ACC3SCAL_Y   1.000
INS_ACC3SCAL_Z   1.000
MOT_THST_EXPO   0.65
MOT_THST_HOVER  0.39
MOT_BAT_VOLT_MIN 9.6
MOT_BAT_VOLT_MAX 12.8
# flightmodes
# switch 1 Circle
# switch 2 LAND
# switch 3 RTL
# switch 4 Auto
# switch 5 Loiter
# switch 6 Stab
# STABILIZE 	0 !
# ACRO 			1
# ALT_HOLD 		2
# AUTO 			3 !
# GUIDED 		4
# LOITER 		5 !
# RTL 			6 !
# CIRCLE 		7 !
# POSITION 		8
# LAND 			9 !
# --- Phase 1: slow, bounded motion in a 5x5 m arena -------------------------
# These are LIMITS on the position controller's output, not tuning gains. They
# are deliberately NOT the block that was bisected out above (docs/PARAMS-DIFF-
# SITL.md): that one softened the attitude loop itself — angle P, ATC_INPUT_TC,
# rate P/I/D, PSC_ANGLE_MAX — until the loop was too slow for the position
# controller to track and had no authority left to recover. Nothing here touches
# a gain or a lean limit. Capping demanded speed and acceleration makes the
# position controller ASK for less; softening the attitude loop made it worse at
# delivering what it was asked for. The first is the safe half of "fly slow".
#
# ArduCopter 4.8.0-dev, where WPNAV_* was renamed WP_* and converted to SI.
# On the real drone's 4.6.3 the same three are WPNAV_SPEED (cm/s, 50),
# WPNAV_ACCEL (cm/s/s, 50) and ATC_SLEW_YAW (cdeg/s, 2500).
#
# GUIDED position targets take their limits from exactly these:
# ModeGuided::pos_control_run calls NE_set_max_speed_accel_m(
#   wp_nav->get_default_speed_NE_ms(), wp_nav->get_wp_acceleration_mss()).
#
# WP_SPD default is 10 m/s — the whole arena crossed in under a second, which is
# neither useful nor survivable indoors. 0.5 m/s puts a 2 m leg at ~4 s plus
# ramps: slow enough to watch, slow enough that a bad position estimate produces
# a slow wander rather than a dash into a wall.
WP_SPD          0.6
# Default 2.5 m/s/s. The acceleration is what the airframe feels when a new
# setpoint appears, and BiguaSim's ~0.3-0.5 s actuation lag is what turns a
# sharp demand into an oscillation (see ~/work/biguasim-problems.md, 2026-08-18).
WP_ACC          0.6
# Yaw slew rate, deg/s. Default 60 deg/s puts a 45 deg search turn at 0.75 s,
# fast enough to smear the visual odometry through the whole step. 25 deg/s
# makes it ~1.8 s, and the mission's settle pause then has something already
# nearly stationary to wait on.
ATC_RATE_WPY_MAX 15
#
# NOT touched, on purpose: WP_SPD_UP / WP_SPD_DN and PILOT_SPEED_UP. The climb
# is the one part of the flight that already behaves, and GUIDED takeoff takes
# its rate from those.
