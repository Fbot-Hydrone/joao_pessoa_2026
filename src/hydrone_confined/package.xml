<?xml version="1.0"?>
<package format="3">
  <name>hydrone_confined</name>
  <version>0.1.0</version>
  <description>Navigation in confined spaces with a 360 deg lidar: virtual beams, beam guard,
    known-map beam localization, pose mux, online grid/openings/frontiers, planner, navigator,
    and a kinematic simulator to run it all without a physics sim. The core is ROS-free.</description>
  <maintainer email="ivoarpino2@gmail.com">Ivo Arpino</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
