<?xml version="1.0"?>
<package format="3">
  <name>hydrone_vision</name>
  <version>1.0.0</version>
  <description>Vision node: base detection, gesture recognition, QR reading</description>
  <maintainer email="team@hydrone.com">Hydrone Team</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>tf2_ros</depend>
  <depend>hydrone_msgs</depend>
  <!-- The occupancy map, for projecting a belly-camera pixel onto the
       surface it actually sees instead of an assumed ground plane. -->
  <depend>hydrone_map</depend>
  <depend>octomap_msgs</depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
